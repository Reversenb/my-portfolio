{
  "compilerOptions": {
   
    "jsx": "react-jsx", // บอกให้ TS รู้ว่าใช้ React 17+ (ไม่ต้อง import React)
    "noUnusedLocals": false, // ปิดการแจ้งเตือนตัวแปรที่ประกาศไว้แต่ไม่ได้ใช้ (ถ้าต้องการความคล่องตัว)
    "noUnusedParameters": false,
    "types": ["react", "react-dom"], // บังคับให้โหลด Type ของ React เข้ามา
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
